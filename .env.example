# Shared secret for signing admin session cookies
AUTH_SECRET=change-me-to-a-long-random-string

# Password required to access /admin
ADMIN_PASSWORD=opendoor-admin

# Optional: override JSON store path (defaults to data/opendoor-store.json locally,
# or /tmp/opendoor-store.json on Vercel)
# DATABASE_PATH=./data/opendoor-store.json
